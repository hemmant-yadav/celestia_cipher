# ============================================================================
# Aura Safety AI - Environment Configuration
# ============================================================================
# Configure your LLM API credentials here.
# NOTE: The built-in 24/7 Safety Knowledge Engine acts as the reliable fallback
# backup whenever the API key is empty, invalid, or offline.

# LLM Provider: "gemini" | "openai" | "custom" | "built-in"
VITE_LLM_PROVIDER=gemini

# Your API Key (e.g., Google Gemini AIzaSy... or OpenAI sk-...)
VITE_LLM_API_KEY=

# Model Name (e.g., gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini)
VITE_LLM_MODEL=gemini-1.5-flash

# Optional: Custom REST Endpoint (if using custom server or proxy)
VITE_LLM_ENDPOINT=

